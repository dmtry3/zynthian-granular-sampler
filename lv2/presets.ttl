        [ lv2:symbol "chaos" ; pset:value 0.0 ] ,
        [ lv2:symbol "pitch" ; pset:value 0.0 ] ,
        [ lv2:symbol "pitch_spray" ; pset:value 0.0 ] ,
        [ lv2:symbol "reverse" ; pset:value 0.0 ] ,
        [ lv2:symbol "quantize" ; pset:value 0.0 ] ,
        [ lv2:symbol "attack" ; pset:value 1.0 ] ,
        [ lv2:symbol "release" ; pset:value 1500.0 ] ,
        [ lv2:symbol "spread" ; pset:value 30.0 ] ,
        [ lv2:symbol "level" ; pset:value 0.8 ] ,
        [ lv2:symbol "cutoff" ; pset:value 20000.0 ] ,
