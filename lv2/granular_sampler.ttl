    lv2:scalePoint [ rdfs:label "4 bars" ; rdf:value 0 ] , [ rdfs:label "2 bars" ; rdf:value 1 ] , [ rdfs:label "1 bar" ; rdf:value 2 ] , [ rdfs:label "1/2" ; rdf:value 3 ] , [ rdfs:label "1/4" ; rdf:value 4 ] , [ rdfs:label "1/4T" ; rdf:value 5 ] , [ rdfs:label "1/8" ; rdf:value 6 ] , [ rdfs:label "1/8T" ; rdf:value 7 ] , [ rdfs:label "1/16" ; rdf:value 8 ] , [ rdfs:label "1/16T" ; rdf:value 9 ] , [ rdfs:label "1/32" ; rdf:value 10 ] ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:granularsampler:sampler#lfo2_div>
