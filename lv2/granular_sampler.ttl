@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix work: <http://lv2plug.in/ns/ext/worker#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix patch: <http://lv2plug.in/ns/ext/patch#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix pg:   <http://lv2plug.in/ns/ext/port-groups#> .
@prefix mod:  <http://moddevices.com/ns/mod#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Knob pages, in this order (higher displayPriority first). Later stages add Pitch, Voice (full), Filter, Mod.
<urn:granularsampler:sampler#g_position> a pg:Group ; lv2:symbol "g_position" ; lv2:name "Position" ; lv2:index 0 ; lv2:displayPriority 60 .
<urn:granularsampler:sampler#g_grain> a pg:Group ; lv2:symbol "g_grain" ; lv2:name "Grain" ; lv2:index 1 ; lv2:displayPriority 50 .
<urn:granularsampler:sampler#g_voice> a pg:Group ; lv2:symbol "g_voice" ; lv2:name "Voice" ; lv2:index 3 ; lv2:displayPriority 30 .

# Sample file: Zynthian shows its file selector for an atom:Path parameter (folders by mod:fileTypes).
# notOnGUI: not on a knob page (that page would show Zynthian's audio_file widget instead of ours);
# our widget opens the file selector with a tap.
<urn:granularsampler:sampler#sample>
    a lv2:Parameter ;
    lv2:symbol "sample" ;
    rdfs:label "Sample" ;
    rdfs:range atom:Path ;
    mod:fileTypes "wav,flac,aiff,aif,ogg,mp3" ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

# Voice mode and count: set in the widget (Grain tab), saved in the snapshot and in LV2 State.
<urn:granularsampler:sampler#mode>
    a lv2:Parameter ;
    lv2:symbol "mode" ;
    rdfs:label "Mode" ;
    rdfs:range atom:Int ;
    lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ;
    lv2:scalePoint [ rdfs:label "Poly" ; rdf:value 0 ] , [ rdfs:label "Mono" ; rdf:value 1 ] ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:granularsampler:sampler#voices>
    a lv2:Parameter ;
    lv2:symbol "voices" ;
    rdfs:label "Voices" ;
    rdfs:range atom:Int ;
    lv2:default 8 ; lv2:minimum 1 ; lv2:maximum 8 ;
    pprops:notOnGUI true ;
    lv2:portProperty pprops:notOnGUI .

<urn:granularsampler:sampler>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Granular Sampler" ;
    lv2:minorVersion 5 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable , state:mapPath , state:freePath ;
    lv2:extensionData state:interface , work:interface ;
    patch:writable <urn:granularsampler:sampler#sample> , <urn:granularsampler:sampler#mode> , <urn:granularsampler:sampler#voices> ;
    # Control input ports MUST be indices 0..N-1 (before atom and audio ports): Zynthian numbers LV2 parameters
    # from len(control ports)+1 and would overwrite a control port with a higher index.
    # Outputs for the widget: playhead and grain1..16 = read positions, 0..1 of the sample, -1 = none.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "position" ; lv2:name "Position" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "scan" ; lv2:name "Scan" ;
        lv2:default 100 ; lv2:minimum -200 ; lv2:maximum 200 ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "spray" ; lv2:name "Spray" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "window" ; lv2:name "Window" ;
        lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "size" ; lv2:name "Size ms" ;
        lv2:default 100 ; lv2:minimum 5 ; lv2:maximum 1000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "density" ; lv2:name "Density" ;
        lv2:default 20 ; lv2:minimum 0.5 ; lv2:maximum 200 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "shape" ; lv2:name "Shape" ;
        lv2:default 67 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "chaos" ; lv2:name "Chaos" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "attack" ; lv2:name "Attack ms" ;
        lv2:default 10 ; lv2:minimum 1 ; lv2:maximum 10000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "release" ; lv2:name "Release ms" ;
        lv2:default 500 ; lv2:minimum 10 ; lv2:maximum 20000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "spread" ; lv2:name "Stereo Spread" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 12 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 13 ; lv2:symbol "out_l" ; lv2:name "Out L" ;
    ] ,
    [
        a lv2:OutputPort , lv2:AudioPort ;
        lv2:index 14 ; lv2:symbol "out_r" ; lv2:name "Out R" ;
    ] ,
    [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports patch:Message ;
        lv2:designation lv2:control ;
        lv2:index 15 ; lv2:symbol "notify" ; lv2:name "Notify" ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "status" ; lv2:name "Status" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 3 ; lv2:portProperty lv2:integer ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "seconds" ; lv2:name "Seconds" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 600 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "playhead" ; lv2:name "Playhead" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "grain1" ; lv2:name "Grain 1" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "grain2" ; lv2:name "Grain 2" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 21 ; lv2:symbol "grain3" ; lv2:name "Grain 3" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 22 ; lv2:symbol "grain4" ; lv2:name "Grain 4" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 23 ; lv2:symbol "grain5" ; lv2:name "Grain 5" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 24 ; lv2:symbol "grain6" ; lv2:name "Grain 6" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 25 ; lv2:symbol "grain7" ; lv2:name "Grain 7" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 26 ; lv2:symbol "grain8" ; lv2:name "Grain 8" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 27 ; lv2:symbol "grain9" ; lv2:name "Grain 9" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 28 ; lv2:symbol "grain10" ; lv2:name "Grain 10" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 29 ; lv2:symbol "grain11" ; lv2:name "Grain 11" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 30 ; lv2:symbol "grain12" ; lv2:name "Grain 12" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 31 ; lv2:symbol "grain13" ; lv2:name "Grain 13" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 32 ; lv2:symbol "grain14" ; lv2:name "Grain 14" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 33 ; lv2:symbol "grain15" ; lv2:name "Grain 15" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] ,
    [
        a lv2:OutputPort , lv2:ControlPort ;
        lv2:index 34 ; lv2:symbol "grain16" ; lv2:name "Grain 16" ;
        lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ;
    ] .
