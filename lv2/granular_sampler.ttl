<urn:granularsampler:sampler>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Granular Sampler" ;
    lv2:minorVersion 13 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map , work:schedule ;
    lv2:optionalFeature lv2:hardRTCapable , state:mapPath , state:freePath ;
    lv2:extensionData state:interface , work:interface ;
    patch:writable <urn:granularsampler:sampler#sample> , <urn:granularsampler:sampler#voices> , <urn:granularsampler:sampler#scale> , <urn:granularsampler:sampler#key> ,
        <urn:granularsampler:sampler#lfo1_shape> , <urn:granularsampler:sampler#lfo2_shape> , <urn:granularsampler:sampler#lfo1_sync> , <urn:granularsampler:sampler#lfo2_sync> , <urn:granularsampler:sampler#env1_shape> , <urn:granularsampler:sampler#env2_shape> , <urn:granularsampler:sampler#mod_depth> , <urn:granularsampler:sampler#glide> , <urn:granularsampler:sampler#lfo1_div> , <urn:granularsampler:sampler#lfo2_div> , <urn:granularsampler:sampler#bend_range> , <urn:granularsampler:sampler#root> , <urn:granularsampler:sampler#tune> , <urn:granularsampler:sampler#gain> , <urn:granularsampler:sampler#mark_start> , <urn:granularsampler:sampler#mark_end> , <urn:granularsampler:sampler#m_lfo1_position> , <urn:granularsampler:sampler#m_lfo1_scan> , <urn:granularsampler:sampler#m_lfo1_spray> , <urn:granularsampler:sampler#m_lfo1_size> , <urn:granularsampler:sampler#m_lfo1_density> , <urn:granularsampler:sampler#m_lfo1_pitch> , <urn:granularsampler:sampler#m_lfo1_pan> , <urn:granularsampler:sampler#m_lfo1_level> , <urn:granularsampler:sampler#m_lfo1_cutoff> , <urn:granularsampler:sampler#m_lfo2_position> , <urn:granularsampler:sampler#m_lfo2_scan> , <urn:granularsampler:sampler#m_lfo2_spray> , <urn:granularsampler:sampler#m_lfo2_size> , <urn:granularsampler:sampler#m_lfo2_density> , <urn:granularsampler:sampler#m_lfo2_pitch> , <urn:granularsampler:sampler#m_lfo2_pan> , <urn:granularsampler:sampler#m_lfo2_level> , <urn:granularsampler:sampler#m_lfo2_cutoff> , <urn:granularsampler:sampler#m_env1_position> , <urn:granularsampler:sampler#m_env1_scan> , <urn:granularsampler:sampler#m_env1_spray> , <urn:granularsampler:sampler#m_env1_size> , <urn:granularsampler:sampler#m_env1_density> , <urn:granularsampler:sampler#m_env1_pitch> , <urn:granularsampler:sampler#m_env1_pan> , <urn:granularsampler:sampler#m_env1_level> , <urn:granularsampler:sampler#m_env1_cutoff> , <urn:granularsampler:sampler#m_env2_position> , <urn:granularsampler:sampler#m_env2_scan> , <urn:granularsampler:sampler#m_env2_spray> , <urn:granularsampler:sampler#m_env2_size> , <urn:granularsampler:sampler#m_env2_density> , <urn:granularsampler:sampler#m_env2_pitch> , <urn:granularsampler:sampler#m_env2_pan> , <urn:granularsampler:sampler#m_env2_level> , <urn:granularsampler:sampler#m_env2_cutoff> , <urn:granularsampler:sampler#m_vel_position> , <urn:granularsampler:sampler#m_vel_scan> , <urn:granularsampler:sampler#m_vel_spray> , <urn:granularsampler:sampler#m_vel_size> , <urn:granularsampler:sampler#m_vel_density> , <urn:granularsampler:sampler#m_vel_pitch> , <urn:granularsampler:sampler#m_vel_pan> , <urn:granularsampler:sampler#m_vel_level> , <urn:granularsampler:sampler#m_vel_cutoff> , <urn:granularsampler:sampler#m_wheel_position> , <urn:granularsampler:sampler#m_wheel_scan> , <urn:granularsampler:sampler#m_wheel_spray> , <urn:granularsampler:sampler#m_wheel_size> , <urn:granularsampler:sampler#m_wheel_density> , <urn:granularsampler:sampler#m_wheel_pitch> , <urn:granularsampler:sampler#m_wheel_pan> , <urn:granularsampler:sampler#m_wheel_level> , <urn:granularsampler:sampler#m_wheel_cutoff> , <urn:granularsampler:sampler#m_rnd_position> , <urn:granularsampler:sampler#m_rnd_scan> , <urn:granularsampler:sampler#m_rnd_spray> , <urn:granularsampler:sampler#m_rnd_size> , <urn:granularsampler:sampler#m_rnd_density> , <urn:granularsampler:sampler#m_rnd_pitch> , <urn:granularsampler:sampler#m_rnd_pan> , <urn:granularsampler:sampler#m_rnd_level> , <urn:granularsampler:sampler#m_rnd_cutoff> ;
    # Control input ports MUST be indices 0..N-1 (before atom and audio ports): Zynthian numbers LV2 parameters
    # from len(control ports)+1 and would overwrite a control port with a higher index.
    # Outputs for the widget: playhead and grain1..16 = read positions, 0..1 of the sample, -1 = none;
    # note1..8 = MIDI note of each sounding voice, -1 = idle.
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "position" ; lv2:name "Position" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "scan" ; lv2:name "Scan" ;
        lv2:default 100 ; lv2:minimum -200 ; lv2:maximum 200 ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "spray" ; lv2:name "Spray" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "window" ; lv2:name "Window" ;
        lv2:default 100 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_position> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 4 ; lv2:symbol "size" ; lv2:name "Size ms" ;
        lv2:default 100 ; lv2:minimum 5 ; lv2:maximum 10000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 5 ; lv2:symbol "density" ; lv2:name "Density" ;
        lv2:default 20 ; lv2:minimum 0.5 ; lv2:maximum 200 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 6 ; lv2:symbol "shape" ; lv2:name "Shape" ;
        lv2:default 67 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 7 ; lv2:symbol "chaos" ; lv2:name "Chaos" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_grain> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 8 ; lv2:symbol "pitch" ; lv2:name "Pitch" ;
        lv2:default 0 ; lv2:minimum -24 ; lv2:maximum 24 ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_pitch> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 9 ; lv2:symbol "pitch_spray" ; lv2:name "Pitch Spray" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 24 ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_pitch> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 10 ; lv2:symbol "reverse" ; lv2:name "Reverse %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_pitch> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 11 ; lv2:symbol "quantize" ; lv2:name "Quantize %" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_pitch> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 12 ; lv2:symbol "attack" ; lv2:name "Attack ms" ;
        lv2:default 10 ; lv2:minimum 1 ; lv2:maximum 10000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 13 ; lv2:symbol "release" ; lv2:name "Release ms" ;
        lv2:default 500 ; lv2:minimum 10 ; lv2:maximum 20000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 14 ; lv2:symbol "spread" ; lv2:name "Stereo Spread" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 15 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.8 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_voice> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 16 ; lv2:symbol "cutoff" ; lv2:name "Cutoff Hz" ;
        lv2:default 20000 ; lv2:minimum 20 ; lv2:maximum 20000 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_filter> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 17 ; lv2:symbol "resonance" ; lv2:name "Resonance" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 30 ; pg:group <urn:granularsampler:sampler#g_filter> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 18 ; lv2:symbol "ftype" ; lv2:name "Type" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 2 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "LP" ; rdf:value 0 ] , [ rdfs:label "HP" ; rdf:value 1 ] , [ rdfs:label "BP" ; rdf:value 2 ] ;
        lv2:displayPriority 20 ; pg:group <urn:granularsampler:sampler#g_filter> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 19 ; lv2:symbol "keytrack" ; lv2:name "Key Track" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 100 ;
        lv2:displayPriority 10 ; pg:group <urn:granularsampler:sampler#g_filter> ;
    ] ,
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 20 ; lv2:symbol "lfo1_rate" ; lv2:name "LFO 1 Hz" ;
        lv2:default 1 ; lv2:minimum 0.01 ; lv2:maximum 20 ;
        lv2:portProperty pprops:logarithmic ;
        lv2:displayPriority 40 ; pg:group <urn:granularsampler:sampler#g_mod> ;
    ] ,
    [
